{
  "name": "@froment/api",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts src/migrate.ts --bundle --platform=node --format=cjs --external:argon2 --external:better-sqlite3 --out-extension:.js=.cjs --outdir=dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.cjs",
    "start": "node dist/main.cjs",
    "test": "pnpm --filter @froment/documents build && pnpm --filter @froment/web build && pnpm build && vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@froment/contracts": "workspace:*",
    "@froment/documents": "workspace:*",
    "@froment/l10n": "workspace:*",
    "@stablelib/ed25519": "^2.1.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "paseto-ts": "^2.0.7",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "catalog:",
    "tough-cookie": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
