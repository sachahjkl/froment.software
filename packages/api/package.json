{
  "name": "@froment/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:playwright-core --outfile=dist/main.cjs",
    "db:generate": "drizzle-kit generate",
    "start": "node dist/main.cjs",
    "test": "pnpm --filter @froment/documents build && pnpm --filter @froment/web build && pnpm build && vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@froment/contracts": "workspace:*",
    "@froment/documents": "workspace:*",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "playwright-core": "catalog:",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
