{
  "name": "froment-software",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @froment/web start",
    "build": "pnpm --recursive --if-present build",
    "watch": "pnpm --filter @froment/web watch",
    "test": "pnpm --recursive --if-present test",
    "test:watch": "pnpm --filter @froment/web test:watch",
    "lint": "oxlint packages/*/src",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "packageManager": "pnpm@11.20.0"
}
